# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# Database (PostgreSQL & Prisma)
# ==========================================
# Use 'db' as host inside Docker, or 'localhost' for local development
DATABASE_URL="postgresql://postgres:password@db:5432/crm_db?schema=public"

# Credentials for Docker PostgreSQL Service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=crm_db

# ==========================================
# Cache & Queue (Redis & BullMQ)
# ==========================================
# Use 'redis' as host inside Docker, or 'localhost' for local development
REDIS_URL="redis://redis:6379"

# ==========================================
# Authentication & JWT
# ==========================================
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN=1d

# ==========================================
# Worker Configuration
# ==========================================
RUN_WORKER=false
